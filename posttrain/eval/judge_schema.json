{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "grades", "ranking", "ranking_reason"],
  "properties": {
    "item_id": {"type": "string"},
    "grades": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "directness", "substance", "coherence", "naturalness", "period_fit", "fatal_failure", "overall_0_100", "evidence", "anachronisms"],
        "properties": {
          "label": {"type": "string"},
          "directness": {"type": "integer", "minimum": 0, "maximum": 4},
          "substance": {"type": "integer", "minimum": 0, "maximum": 4},
          "coherence": {"type": "integer", "minimum": 0, "maximum": 4},
          "naturalness": {"type": "integer", "minimum": 0, "maximum": 4},
          "period_fit": {"type": "integer", "minimum": 0, "maximum": 4},
          "fatal_failure": {"type": "boolean"},
          "overall_0_100": {"type": "number", "minimum": 0, "maximum": 100},
          "evidence": {"type": "string"},
          "anachronisms": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "ranking": {
      "type": "array",
      "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "ranking_reason": {"type": "string"}
  }
}
